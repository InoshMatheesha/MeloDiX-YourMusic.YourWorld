{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodix",
  "version": "2.0.4",
  "identifier": "io.github.inoshmatheesha.moodex",
  "build": {
    "frontendDist": "../webroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../sidecar": "sidecar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
